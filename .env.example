# Personal settings. Copy this file to ".env" (same folder) and fill it in.
# .env is not committed to git, so everyone keeps their own.

# Your initials or a short name (letters/numbers). It is added to every saved file
# name so labels from different people never clash when they are combined:
#   Gainesville_3-0_p1_AC_t4.las
LABELLER=

# Folder that receives your labelled patches (in <folder>/labels) and the dataset
# overview file (labelling_registry.json). Default: the "data" folder in this repo.
# Use forward slashes, also on Windows, e.g. C:/Users/you/Documents/tree-labels
# DATASET_DIR_HOST=./data

# Port of the app: http://localhost:8080  (change if 8080 is already in use)
# PORT=8080

# Only needed if the model repository on Hugging Face is private.
# HF_TOKEN=

# Upload limit in bytes (2 GB) and points drawn in the 2D view
# MAX_UPLOAD_BYTES=2147483648
# DEFAULT_MAX_POINTS=500000
